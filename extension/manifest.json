{
  "manifest_version": 3,
  "name": "Page Title and URL Capture",
  "version": "1.0.0",
  "description": "Captures the current page title and URL from every page and sends it to the background service worker.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "history"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Ambi — Context"
    },
    "open-links": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Ambi — Links"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "Readability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
